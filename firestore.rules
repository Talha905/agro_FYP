rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile matching
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Community Crop Presets: Public read, public/authenticated incremental updates
    match /community_crop_presets/{presetId} {
      allow read, write: if true;
    }

    // Recommendation Votes: One vote document per user per recommendation setup
    match /recommendation_votes/{voteId} {
      allow read, write: if true;
    }

    // Recommendation History
    match /recommendations/{docId} {
      allow read, write: if request.auth != null || request.resource.data.farmerId != null;
    }

    // Growth Plans
    match /growth_plans/{planId} {
      allow read, write: if request.auth != null || true;
    }
  }
}
