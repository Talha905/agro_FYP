rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile matching
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Community Crop Presets: Public read, authenticated incremental updates
    match /community_crop_presets/{presetId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }

    // Recommendation Votes: One vote document per user per recommendation setup
    match /recommendation_votes/{voteId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Growth Plans
    match /growth_plans/{planId} {
      allow read, write: if request.auth != null;
    }
  }
}
